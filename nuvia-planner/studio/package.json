{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node tools/require-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm --filter @workspace/nuvia-ui-review build",
    "typecheck:libs": "tsc --build lib/api-client-react",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/nuvia-ui-review typecheck",
    "dev": "pnpm --filter @workspace/nuvia-ui-review dev"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
