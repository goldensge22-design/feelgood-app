{
  "schemaVersion": 1,
  "defaultLocale": "ko",
  "fallbackLocale": "ko",
  "localeCatalog": {
    "ko": {"label": "한국어", "dir": "ltr"},
    "en": {"label": "English", "dir": "ltr"},
    "ja": {"label": "日本語", "dir": "ltr"},
    "zh": {"label": "中文", "dir": "ltr", "canonical": "zh-CN"},
    "zh-CN": {"label": "简体中文", "dir": "ltr"},
    "zh-TW": {"label": "繁體中文", "dir": "ltr"},
    "mn": {"label": "Монгол", "dir": "ltr"},
    "th": {"label": "ไทย", "dir": "ltr"},
    "vi": {"label": "Tiếng Việt", "dir": "ltr"},
    "ar": {"label": "العربية", "dir": "rtl"},
    "ru": {"label": "Русский", "dir": "ltr"},
    "km": {"label": "ខ្មែរ", "dir": "ltr"},
    "es": {"label": "Español", "dir": "ltr"},
    "fr": {"label": "Français", "dir": "ltr"},
    "it": {"label": "Italiano", "dir": "ltr"},
    "az": {"label": "Azərbaycan", "dir": "ltr"}
  },
  "programs": [
    {
      "id": "proposal",
      "mode": "strict",
      "format": "js-global",
      "html": "proposal/index.html",
      "localeDir": "proposal/i18n",
      "supportedLocales": ["ko", "en", "zh", "mn", "th", "vi", "ja", "ar", "ru"],
      "defaultLocale": "ko",
      "fallbackLocale": "ko"
    },
    {
      "id": "proposal-v2",
      "mode": "strict",
      "format": "js-global-manifest",
      "html": "proposal-v2 (1).html",
      "manifest": "proposal-v2/i18n/manifest.js",
      "localeDir": "proposal-v2/i18n",
      "defaultLocale": "ko",
      "fallbackLocale": "ko"
    },
    {
      "id": "teacher-guide",
      "mode": "strict",
      "format": "json-source-map",
      "manifest": "teacher-guide/locales/languages.json",
      "localeDir": "teacher-guide/locales",
      "sourceLocale": "ko",
      "defaultLocale": "ko",
      "fallbackLocale": "ko",
      "notes": "현재 locale pack은 한국어 원문 문자열을 key로 사용한다. 기존 기능을 보존하며 안정 key로 점진 이행한다."
    },
    {
      "id": "school-dashboard-demo",
      "mode": "strict",
      "format": "json-keyed-manifest",
      "html": "school-dashboard-demo/homeroom.html",
      "manifest": "school-dashboard-demo/locales/manifest.json",
      "localeDir": "school-dashboard-demo/locales",
      "sourceLocale": "ko",
      "defaultLocale": "ko",
      "fallbackLocale": "ko",
      "notes": "학교 대시보드 데모 3종이 공유하는 안정 key 기반 locale pack. 외국어는 ai-draft이며 사용자 화면에는 검수 메타데이터를 노출하지 않는다."
    }
  ]
}
